# Specter AI — Environment Variables
# Copy to .env and fill in your values. Loaded on app startup (main process).

AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional assistant defaults
ASSISTANT_MODE=general
FULL_AUTO_MODE=true
JOURNAL_SMART_CROP=true

# Optional — OpenRouter backend
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
